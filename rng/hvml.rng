<?xml version="1.0" encoding="UTF-8"?>
<grammar
  xmlns="http://relaxng.org/ns/structure/1.0"
  xmlns:xml="http://www.w3.org/XML/1998/namespace"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:css="https://www.w3.org/TR/CSS/"
  ns="https://hypervideo.tech/hvml#"
  datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes"
>
  <!-- <include href="atom.rng" /> -->
  <define name="anyXHTML">
    <element>
      <nsName ns="http://www.w3.org/1999/xhtml" />
      <zeroOrMore>
        <choice>
          <attribute>
            <anyName />
          </attribute>
          <text />
          <ref name="anyXHTML" />
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="anyCSS">
    <zeroOrMore>
      <attribute>
        <nsName ns="https://www.w3.org/TR/CSS/" />
        <text />
      </attribute>
    </zeroOrMore>
  </define>

  <define name="xhtmlDiv">
    <element name="xhtml:div">
      <zeroOrMore>
        <choice>
          <attribute>
            <anyName />
          </attribute>
          <text />
          <ref name="anyXHTML" />
        </choice>
      </zeroOrMore>
    </element>
  </define>

  <define name="atomPlainTextConstruct">
    <!-- <ref name="atomCommonAttributes" /> -->
    <ref name="hvmlGlobalAttributes" />
    <optional>
      <attribute name="type">
        <choice>
          <value>text</value>
          <value>html</value>
        </choice>
      </attribute>
    </optional>
    <text />
  </define>

  <define name="atomXHTMLTextConstruct">
    <!-- <ref name="atomCommonAttributes" /> -->
    <ref name="hvmlGlobalAttributes" />
    <attribute name="type">
      <value>xhtml</value>
    </attribute>
    <ref name="xhtmlDiv" />
  </define>

  <define name="atomTextConstruct">
    <choice>
      <ref name="atomPlainTextConstruct" />
      <ref name="atomXHTMLTextConstruct" />
    </choice>
  </define>

  <define name="xmlSpace">
    <attribute name="xml:space">
      <choice>
        <value>default</value>
        <value>preserve</value>
      </choice>
    </attribute>
  </define>

  <define name="xmlLang">
    <attribute name="xml:lang">
      <data type="language" />
    </attribute>
  </define>

  <define name="xmlBase">
    <attribute name="xml:base">
      <data type="anyURI" />
    </attribute>
  </define>

  <define name="xmlId">
    <attribute name="xml:id">
      <data type="ID" />
    </attribute>
  </define>

  <define name="xmlGlobalAttributes">
    <optional>
      <ref name="xmlLang" />
    </optional>
    <optional>
      <ref name="xmlSpace" />
    </optional>
    <optional>
      <ref name="xmlBase" />
    </optional>
    <optional>
      <ref name="xmlId" />
    </optional>
  </define>

  <!--
    Every HVML element accepts the xml:* attributes; their specs
    define them as global across vocabularies. `xml:base` matters
    most at the root: IRIs formed from `xml:id` values resolve
    against it, so a copied document keeps its global names.
  -->
  <define name="hvmlGlobalAttributes">
    <ref name="xmlGlobalAttributes" />
  </define>

  <!--
    `about` holds an absolute IRI naming the thing its element
    describes (hvml-spec
    docs/2026-08-03-identity-versions-presentations.md §2.2). A
    `video` carrying a registry entry’s IRI
    (about="https://id.nospoon.tv/2011/drive") merges, at the RDF
    layer, with every other document about the same IRI. An author
    publishing an annotation track names their own `presentation` the
    same way, under a domain they control.

    Only elements that describe identifiable things take `about`:
    `video` (a work), `version` (an edit of it), `presentation` (an
    experience of it), `overlay` (an annotation on it). Elements that
    describe properties of those things (`title`, `runtime`, etc.)
    take none. NOTE: this scoping is temporary while the grammar
    hardens; we expect to lift it so that mixed-vocabulary XML
    documents (HVML + Atom + XHTML + RDFa) conform.
  -->
  <define name="aboutAttribute">
    <attribute name="about">
      <data type="anyURI" />
    </attribute>
  </define>

  <!-- http://www.microhowto.info/howto/match_arbitrary_content_using_relax_ng.html -->
  <define name="anyContent">
    <interleave>
      <zeroOrMore>
        <ref name="anyElement" />
      </zeroOrMore>
      <text />
    </interleave>
  </define>

  <define name="anyElement">
    <element>
      <anyName />
      <zeroOrMore>
        <ref name="anyAttribute" />
      </zeroOrMore>
      <zeroOrMore>
        <ref name="anyContent" />
      </zeroOrMore>
    </element>
  </define>

  <define name="anyAttribute">
    <attribute>
      <anyName />
    </attribute>
  </define>

  <define name="title">
    <element name="title">
      <ref name="hvmlGlobalAttributes" />
      <text />
    </element>
  </define>

  <define name="episode">
    <element name="episode">
      <ref name="hvmlGlobalAttributes" />
      <data type="integer" />
    </element>
  </define>

  <define name="recorded">
    <element name="recorded">
      <ref name="hvmlGlobalAttributes" />
      <data type="date" />
    </element>
  </define>

  <define name="description">
    <element name="description">
      <ref name="atomTextConstruct"/>
    </element><!--/description-->
  </define>

  <!--
    Typed payload, following the same pattern as
    `description type="xhtml"` (and Atom’s element of the same job).
    The `type` attribute leaves room for non-text payloads.
  -->
  <define name="content">
    <element name="content">
      <ref name="atomTextConstruct" />
    </element><!--/content-->
  </define>

  <define name="entity">
    <element name="entity">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="site" />
      <text />
    </element>
  </define>

  <define name="uri">
    <element name="uri">
      <ref name="hvmlGlobalAttributes" />
      <data type="anyURI" />
    </element>
  </define>

  <!--
    `rel`: `presents` | `derived-from` | `info` (open set while the vocabulary settles)
  -->
  <define name="link">
    <element name="link">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="rel" />
      <attribute name="href">
        <data type="anyURI" />
      </attribute>
    </element>
  </define>

  <define name="runtime">
    <element name="runtime">
      <ref name="hvmlGlobalAttributes" />
      <choice>
        <data type="duration" />
        <ref name="nonNegativeDecimal" />
      </choice>
    </element>
  </define>

  <define name="venue">
    <element name="venue">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <attribute name="type">
          <choice>
            <value>site</value>
            <value>theater</value>
          </choice>
        </attribute>
      </optional>
      <ref name="entity" />
      <optional>
        <ref name="uri" />
      </optional>
      <optional>
        <ref name="title" />
      </optional>
    </element><!--/venue-->
  </define>

  <!--
    scope="screening"
    type="theatrical"
    admission="private"
    datetime="2011-09-16"
    locale="en-US"
  -->
  <define name="showing">
    <element name="showing">
      <ref name="hvmlGlobalAttributes" />
      <interleave>
        <ref name="venue" />
        <zeroOrMore>
          <ref name="link" />
        </zeroOrMore>
      </interleave>
      <optional>
        <attribute name="scope">
          <choice>
            <value>release</value>
            <value>screening</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="type">
          <choice>
            <value>internet</value>
            <value>theatrical</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="admission">
          <choice>
            <value>public</value>
            <value>private</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="datetime">
          <choice>
            <data type="dateTime" />
            <data type="date" />
            <data type="time" />
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="locale">
          <data type="language" />
        </attribute>
      </optional>
    </element><!--/showing-->
  </define>

  <define name="name">
    <element name="name">
      <ref name="atomTextConstruct" />
    </element>
  </define>

  <define name="simpleName">
    <element name="name">
      <ref name="hvmlGlobalAttributes" />
      <text />
    </element>
  </define>

  <define name="nonNegativeDecimal">
    <data type="decimal">
      <param name="minInclusive">0</param>
    </data>
  </define>

  <define name="percentage">
    <data type="token">
      <param name="pattern">([\-+])?(\d*)\.?(\d*)%</param>
    </data>
  </define>

  <define name="nonNegativePercentage">
    <data type="token">
      <param name="pattern">([+])?(\d*)\.?(\d*)%</param>
    </data>
  </define>

  <define name="onAttribute">
    <attribute name="on">
      <choice>
        <value>durationStart</value><!-- t=0 -->
        <value>duration</value>
        <value>durationEnd</value>
      </choice>
    </attribute>
  </define>

  <!--
    Timing and geometry attribute groups for the annotation
    vocabulary. Grammar reuse comes from these shared patterns, not
    shared element names.

    `on` names the playback phase; absent means `duration`.
    `start`/`end` bound the active window in reference-timeline seconds,
    within `on="duration"`.
  -->
  <define name="timingAttributes">
    <optional>
      <ref name="onAttribute" />
    </optional>
    <optional>
      <attribute name="start">
        <ref name="nonNegativeDecimal" />
      </attribute>
    </optional>
    <optional>
      <attribute name="end">
        <ref name="nonNegativeDecimal" />
      </attribute>
    </optional>
  </define>

  <!--
    A percentage box in the CSS inset vocabulary. Insets may go
    negative for offscreen placement; dimensions may not.
  -->
  <define name="geometryAttributes">
    <optional>
      <attribute name="width">
        <ref name="nonNegativePercentage" />
      </attribute>
    </optional>
    <optional>
      <attribute name="height">
        <ref name="nonNegativePercentage" />
      </attribute>
    </optional>
    <optional>
      <attribute name="top">
        <ref name="percentage" />
      </attribute>
    </optional>
    <optional>
      <attribute name="right">
        <ref name="percentage" />
      </attribute>
    </optional>
    <optional>
      <attribute name="bottom">
        <ref name="percentage" />
      </attribute>
    </optional>
    <optional>
      <attribute name="left">
        <ref name="percentage" />
      </attribute>
    </optional>
  </define>

  <!--
    `animate`’s attribute pairs as named patterns. The lowercase
    variants serve documents that passed through case-folding HTML
    parsers; both spellings are accepted.
  -->
  <define name="animateTimingAttributes">
    <choice>
      <attribute name="startTime">
        <ref name="nonNegativeDecimal" />
      </attribute>
      <attribute name="starttime">
        <ref name="nonNegativeDecimal" />
      </attribute>
    </choice>
    <choice>
      <attribute name="endTime">
        <ref name="nonNegativeDecimal" />
      </attribute>
      <attribute name="endtime">
        <ref name="nonNegativeDecimal" />
      </attribute>
    </choice>
  </define>

  <define name="animateMotionAttributes">
    <choice>
      <attribute name="startX">
        <ref name="percentage" />
      </attribute>
      <attribute name="startx">
        <ref name="percentage" />
      </attribute>
    </choice>
    <choice>
      <attribute name="startY">
        <ref name="percentage" />
      </attribute>
      <attribute name="starty">
        <ref name="percentage" />
      </attribute>
    </choice>
    <choice>
      <attribute name="endX">
        <ref name="percentage" />
      </attribute>
      <attribute name="endx">
        <ref name="percentage" />
      </attribute>
    </choice>
    <choice>
      <attribute name="endY">
        <ref name="percentage" />
      </attribute>
      <attribute name="endy">
        <ref name="percentage" />
      </attribute>
    </choice>
  </define>

  <define name="animate">
    <element name="animate">
      <ref name="hvmlGlobalAttributes" />
      <ref name="animateTimingAttributes" />
      <ref name="animateMotionAttributes" />
      <empty />
    </element>
  </define>

  <!-- https://www.w3.org/TR/xlink11/#actuate-att -->
  <define name="xlinkActuate">
    <attribute name="xlink:actuate">
      <choice>
        <value>onLoad</value>
        <value>onRequest</value>
        <value>other</value>
        <value>none</value>
      </choice>
    </attribute>
    <ref name="xlinkHref" />
  </define>

  <!-- https://www.w3.org/TR/xlink11/#show-att -->
  <define name="xlinkShow">
    <attribute name="xlink:show">
      <choice>
        <value>new</value>
        <value>replace</value>
        <value>embed</value>
        <value>other</value>
        <value>none</value>
      </choice>
    </attribute>
  </define>

  <!--
    <goto
      on="duration"
      xlink:actuate="onRequest"
      xlink:href="https://www.facebook.com/hugh.guiney/videos/10100195051457860/"
      width="70%"
      height="13%"
      css:font-size="calc(384 / 150 * 1vw)"
      css:font-family="'Noto Sans CJK JP', 'Noto Sans CJK', 'Noto Sans', sans-serif"
      css:white-space="nowrap"
      css:overflow="hidden"
    -->
  <define name="goto">
    <element name="goto">
      <ref name="hvmlGlobalAttributes" />
      <ref name="onAttribute" />
      <optional>
        <ref name="xlinkActuate" />
      </optional>
      <optional>
        <ref name="dimensionAttributes--percentage" />
      </optional>
      <optional>
        <ref name="anyCSS" />
      </optional>
      <zeroOrMore>
        <ref name="animate" />
      </zeroOrMore>
    </element>
  </define>

  <!--
    Inside `overlay`, `goto` carries only the link; the overlay owns
    timing and geometry.
  -->
  <define name="goto--pureAction">
    <element name="goto">
      <ref name="hvmlGlobalAttributes" />
      <ref name="xlinkActuate" />
    </element>
  </define>

  <define name="choice">
    <element name="choice">
      <ref name="hvmlGlobalAttributes" />
      <ref name="name" />
      <ref name="goto" />
    </element><!--/choice-->
  </define>

  <define name="xlinkHref">
    <attribute name="xlink:href">
      <data type="anyURI" />
      <!-- @todo: #xpointer() -->
    </attribute>
  </define>

  <define name="dimensionAttributes">
    <group>
      <attribute name="width">
        <data type="positiveInteger" />
      </attribute>
      <attribute name="height">
        <data type="positiveInteger" />
      </attribute>
    </group>
  </define>

  <define name="dimensionAttributes--percentage">
    <group>
      <attribute name="width">
        <ref name="nonNegativePercentage" />
      </attribute>
      <attribute name="height">
        <ref name="nonNegativePercentage" />
      </attribute>
    </group>
  </define>

  <define name="dimensionElements">
    <group>
      <element name="width">
        <ref name="hvmlGlobalAttributes" />
        <data type="positiveInteger" />
      </element>
      <element name="height">
        <ref name="hvmlGlobalAttributes" />
        <data type="positiveInteger" />
      </element>
    </group>
  </define>

  <define name="poster">
    <element name="poster">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <ref name="dimensionAttributes" />
      </optional>
      <ref name="xlinkHref" />
    </element>
  </define>

  <define name="frametype">
    <element name="frametype">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="abbr" />
      <text />
    </element>
  </define>

  <define name="par">
    <element name="par">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="x">
        <data type="integer" />
      </attribute>
      <attribute name="y">
        <data type="integer" />
      </attribute>
    </element>
  </define>

  <define name="fps">
    <element name="fps">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="rate">
        <data type="integer" />
      </attribute>
      <attribute name="scale">
        <data type="integer" />
      </attribute>
    </element>
  </define>

  <define name="mime">
    <element name="mime">
      <ref name="hvmlGlobalAttributes" />
      <text />
    </element>
  </define>

  <define name="bitrate">
    <element name="bitrate">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="type">
        <choice>
          <value>cbr</value>
          <value>vbr</value>
          <value>abr</value>
        </choice>
      </attribute>
      <data type="nonNegativeInteger" />
    </element>
  </define>

  <define name="bitdepth">
    <element name="bitdepth">
      <ref name="hvmlGlobalAttributes" />
      <text /><!-- @todo -->
    </element>
  </define>

  <define name="codec">
    <element name="codec">
      <ref name="hvmlGlobalAttributes" />
      <attribute name="type">
        <choice>
          <value>video</value>
          <value>audio</value>
        </choice>
      </attribute>
      <optional>
        <ref name="simpleName" />
      </optional>
      <ref name="mime" />
      <optional>
        <ref name="bitrate" />
      </optional>
      <optional>
        <ref name="bitdepth" />
      </optional>
    </element>
  </define>

  <define name="container">
    <element name="container">
      <ref name="hvmlGlobalAttributes" />
      <interleave>
        <ref name="simpleName" />
        <ref name="mime" />
        <ref name="codec" />
      </interleave>
    </element>
  </define>

  <define name="file">
    <element name="file">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <attribute name="label" />
      </optional>
      <ref name="xlinkHref" />
      <optional>
        <ref name="dimensionElements" />
      </optional>
      <optional>
        <ref name="container" />
      </optional>
    </element>
  </define>

  <!--
    The standalone time- and space-scoped annotation unit (“text
    overlay”, “graphic overlay”). Geometry and timing live on the
    overlay, which renders whether or not it is interactive: `content`
    carries the payload; an optional `goto` adds the action.
  -->
  <define name="overlay">
    <element name="overlay">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <ref name="aboutAttribute" />
      </optional>
      <ref name="timingAttributes" />
      <ref name="geometryAttributes" />
      <ref name="content" />
      <optional>
        <ref name="goto--pureAction" />
      </optional>
    </element><!--/overlay-->
  </define>

  <!--
    PROVISIONAL: adopted for experimentation, not yet ratified
    (hvml-spec docs/2026-08-03-identity-versions-presentations.md §3).

    Maps the presenting resource’s local timeline onto its version’s
    reference timeline: local = offset + reference × rate/scale, with
    an integer rate/scale pair per the `fps` idiom. Linear-only by
    design; repeating `sync` with segment boundaries is reserved for
    piecewise maps (roadshow overtures, broadcast edits) and
    deliberately unbuilt.
  -->
  <define name="sync">
    <element name="sync">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <attribute name="offset">
          <data type="decimal" />
        </attribute>
      </optional>
      <optional>
        <group>
          <attribute name="rate">
            <data type="integer" />
          </attribute>
          <attribute name="scale">
            <data type="integer" />
          </attribute>
        </group>
      </optional>
      <empty />
    </element>
  </define>

  <define name="presentation">
    <element name="presentation">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <ref name="aboutAttribute" />
      </optional>
      <interleave>
        <optional>
          <ref name="poster" />
        </optional>
        <optional>
          <ref name="frametype" />
        </optional>
        <optional>
          <ref name="par" />
        </optional>
        <optional>
          <ref name="fps" />
        </optional>
        <optional>
          <ref name="sync" />
        </optional>
        <zeroOrMore>
          <ref name="file" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="choice" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="overlay" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="link" />
        </zeroOrMore>
      </interleave>
    </element><!--/presentation-->
  </define>

  <!--
    The expression layer: which content this is, as distinct from
    which work (`video`) and which artifact (`presentation`, `file`).
    `type`: `theatrical` | `directors-cut` | `workprint` | `broadcast` | … (open set).
    `datetime` dates a revision, for works whose file versions are the
    editorial versions (unreleased and in-progress material).
  -->
  <define name="version">
    <element name="version">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <ref name="aboutAttribute" />
      </optional>
      <optional>
        <attribute name="type" />
      </optional>
      <optional>
        <attribute name="datetime">
          <choice>
            <data type="dateTime" />
            <data type="date" />
          </choice>
        </attribute>
      </optional>
      <interleave>
        <optional>
          <ref name="title" />
        </optional>
        <optional>
          <ref name="runtime" />
        </optional>
        <optional>
          <ref name="fps" />
        </optional>
        <optional>
          <ref name="description" />
        </optional>
        <zeroOrMore>
          <ref name="link" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="showing" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="presentation" />
        </zeroOrMore>
      </interleave>
    </element><!--/version-->
  </define>

  <define name="video">
    <element name="video">
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <ref name="aboutAttribute" />
      </optional>
      <optional>
        <attribute name="type">
          <list>
            <oneOrMore>
              <choice>
                <!-- <value>short</value> -->
                <value>narrative</value>
                <value>ad</value>
                <value>personal</value>
                <value>historical</value>
              </choice>
            </oneOrMore>
          </list>
        </attribute>
      </optional>
      <interleave>
        <!-- `title` alone is required: a record must at least name its work -->
        <ref name="title" />
        <optional>
          <ref name="episode" />
        </optional>
        <optional>
          <ref name="recorded" />
        </optional>
        <optional>
          <ref name="description" />
        </optional>
        <zeroOrMore>
          <ref name="version" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="showing" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="presentation" />
        </zeroOrMore>
        <zeroOrMore>
          <ref name="link" />
        </zeroOrMore>
      </interleave>
    </element><!--/video-->
  </define>

  <start>
    <element name="hvml">
      <zeroOrMore>
        <ref name="video" />
      </zeroOrMore>
      <ref name="hvmlGlobalAttributes" />
      <optional>
        <attribute name="xsi:schemaLocation" />
      </optional>
      <optional>
        <attribute name="hidden" />
      </optional>
      <optional>
        <attribute name="xhtml:hidden" />
      </optional>
    </element>
  </start>
</grammar>